  "sources": [
    {
      "id": "01_together",
      "title": "혼자 말고, 함께 집중해요",
      "source": "redpanda-focus.png",
      "alt": "랫서팬더가 책상에서 공부하고, 실제 집중 타이머에 25분이 표시됩니다."
    },
    {
      "id": "02_friends",
      "title": "내 마음에 드는 친구와 함께",
      "source": "friends.png",
      "alt": "친구 선택 화면의 랫서팬더·펭귄·해달·다람쥐와 사막여우의 실제 책상 화면입니다."
    },
    {
      "id": "03_day_and_night",
      "title": "아침부터 밤까지, 나만의 집중방",
      "source": "room-morning.png",
      "alt": "같은 랫서팬더 책상이 아침, 낮, 저녁, 밤의 빛으로 바뀌는 실제 앱 화면 네 개입니다."
    },
    {
      "id": "04_focus_sounds",
      "title": "편안한 소리로 몰입해요",
      "source": "sound.png",
      "alt": "집중 사운드 화면에서 빗소리, 숲, 장작 소리를 선택하고 음량을 조절할 수 있습니다."
    },
    {
      "id": "05_small_habits",
      "title": "작은 집중이 쌓이는 하루",
      "source": "records.png",
      "alt": "2026년 10월의 예시 집중 기록입니다. 달력에 집중한 날의 랫서팬더 스탬프가 표시됩니다."
    },
    {
      "id": "06_little_rewards",
      "title": "집중 끝에 만나는 작은 선물",
      "source": "collection.png",
      "alt": "모은 소품 화면에 집중으로 해금한 작은 화분, 따뜻한 머그컵, 포근한 조명이 표시됩니다."
    }
  ],
