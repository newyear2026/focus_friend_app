<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Match Flutter's warm paper startup in both system light and dark modes. -->
    <style name="BaseLaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/startup_background</item>
        <item name="android:statusBarColor">@color/startup_background</item>
        <item name="android:navigationBarColor">@color/startup_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <style name="LaunchTheme" parent="BaseLaunchTheme" />
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/startup_background</item>
    </style>
</resources>
